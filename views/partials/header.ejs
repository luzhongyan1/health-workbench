<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : '管理平台' %> - <%= appName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  </head>
  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
      <div class="container">
        <a class="navbar-brand" href="/">体检管理平台</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <%
              // 导航按角色渲染：SSC/admin 全视角；招聘端只见招聘；培训师只见培训
              const _role = (typeof currentUser !== 'undefined' && currentUser) ? currentUser.role : null;
              const _nav = [];
              if (_role === 'ssc' || _role === 'admin') {
                _nav.push({ href: '/', label: '首页' });
                _nav.push({ href: '/standards', label: '标准规则' });
                _nav.push({ href: '/recruiter', label: '招聘' });
                _nav.push({ href: '/ssc', label: 'SSC' });
                _nav.push({ href: '/training', label: '培训' });
              } else if (_role === 'recruiter') {
                _nav.push({ href: '/recruiter', label: '招聘名单' });
              } else if (_role === 'trainer') {
                _nav.push({ href: '/training', label: '培训查询' });
              }
            %>
            <% _nav.forEach(function(item) { %>
              <li class="nav-item"><a class="nav-link" href="<%= item.href %>"><%= item.label %></a></li>
            <% }); %>
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
              <li class="nav-item">
                <a class="nav-link disabled">用户: <%= currentUser.username %> (<%= currentUser.role %>)</a>
              </li>
              <li class="nav-item"><a class="nav-link" href="/logout">登出</a></li>
            <% } else { %>
              <li class="nav-item"><a class="nav-link" href="/login">登录</a></li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>
