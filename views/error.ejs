          <div class="d-flex gap-2 justify-content-center">
            <a href="/" class="btn btn-primary">返回首页</a>
            <button type="button" class="btn btn-outline-secondary" onclick="history.back()">返回上一页</button>
          </div>
        </div>
      </div>
    </div>
<%- include('partials/footer') %>
