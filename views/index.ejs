<%- include('partials/header') %>
<main class="container py-5">
  <div class="row g-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h1 class="h3 mb-3">
            欢迎回来<%= typeof currentUser !== 'undefined' && currentUser ? '，' + currentUser.username : '' %>
          </h1>
          <p class="text-muted mb-4">员工入职体检管理平台 P0 一期已就绪，可以开始录入和管理数据。</p>
          <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" href="/recruiter">招聘端 · 名单导入</a>
            <a class="btn btn-outline-primary" href="/ssc">SSC · 上传与审核</a>
            <a class="btn btn-outline-primary" href="/training">培训师 · 员工列表</a>
            <a class="btn btn-outline-secondary" href="/standards">标准规则管理</a>
          </div>
          <details class="mt-4">
            <summary class="text-muted" style="cursor:pointer">高级操作：手动执行数据库迁移</summary>
            <div class="mt-2">
              <button class="btn btn-warning btn-sm" onclick="runSetup()">初始化数据库</button>
            </div>
          </details>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h6 text-uppercase text-muted">数据库状态</h2>
          <p class="display-6 mb-0"><%= dbTime ? '已连接' : '未连接' %></p>
          <% if (dbTime) { %>
            <p class="text-muted mt-2">当前时间：<%= dbTime.now %></p>
          <% } %>
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-warning mt-3 mb-0"><%= error %></div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h6 text-uppercase text-muted">当前数据概览</h2>
          <div class="row g-3 mt-1">
            <div class="col-sm-12">
              <div class="border rounded p-3">
                <div class="text-muted small">待检人员</div>
                <div class="display-5 fw-bold text-primary mb-0"><%= needsCount %></div>
                <div class="text-muted small mt-2">实时比对：最新招聘上传名单 ∩ 90 天内无历史体检合格记录</div>
              </div>
            </div>
          </div>
          <div class="mt-3">
            <small class="text-muted">提示：先在 <code>/standards</code> 录入体检标准 → 在 <code>/recruiter</code> 导入名单 → 在 <code>/ssc</code> 上传历史/本次结果（上传成功后此处自动归零）。</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  async function runSetup() {
    const res = await fetch('/setup', { method: 'POST' });
    const result = await res.json();
    alert(result.message || '已完成初始化');
    window.location.reload();
  }
</script>
</body>
</html>
