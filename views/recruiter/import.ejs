<%- include('../partials/header') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h4">导入体检预约名单</h1>
      <p class="text-muted">上传招聘部门的Excel名单，系统自动处理历史查重。</p>
    </div>
    <a href="/recruiter" class="btn btn-outline-secondary">返回</a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <% if (result) { %>
    <div class="alert alert-success">
      导入成功：<%= result.imported %> 条，免检 <%= result.exempt %> 人，需预约 <%= result.needsAppointment %> 人。
    </div>
  <% } %>

  <form action="/recruiter/import" method="post" enctype="multipart/form-data">
    <div class="mb-3">
      <label class="form-label">上传 Excel 文件</label>
      <input type="file" name="file" class="form-control" accept=".xlsx" required />
    </div>
    <button type="submit" class="btn btn-primary">上传并处理</button>
  </form>
</div>

<%- include('../partials/footer') %>
