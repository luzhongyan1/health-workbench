<%- include('../partials/header') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h4"><%= standard.id ? '编辑标准规则' : '新增标准规则' %></h1>
      <p class="text-muted">填写标准项目配置，系统将在 AI 判断中使用。</p>
    </div>
    <a href="/standards" class="btn btn-outline-secondary">返回列表</a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <form action="<%= action %>" method="post">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">标准名称</label>
        <input name="name" type="text" class="form-control" value="<%= standard.name || '' %>" required />
      </div>
      <div class="col-md-6">
        <label class="form-label">体检项目</label>
        <input name="item_name" type="text" class="form-control" value="<%= standard.item_name || '' %>" required />
      </div>
      <div class="col-md-4">
        <label class="form-label">单位</label>
        <input name="unit" type="text" class="form-control" value="<%= standard.unit || '' %>" />
      </div>
      <div class="col-md-4">
        <label class="form-label">合格范围</label>
        <input name="pass_range" type="text" class="form-control" value="<%= standard.pass_range || '' %>" />
      </div>
      <div class="col-md-4">
        <label class="form-label">红灯阈值</label>
        <input name="red_threshold" type="text" class="form-control" value="<%= standard.red_threshold || '' %>" />
      </div>
      <div class="col-md-4">
        <label class="form-label">复查阈值</label>
        <input name="recheck_threshold" type="text" class="form-control" value="<%= standard.recheck_threshold || '' %>" />
      </div>
      <div class="col-md-4">
        <label class="form-label">版本号</label>
        <input name="version" type="number" min="1" class="form-control" value="<%= standard.version || 1 %>" />
      </div>
      <div class="col-md-4 d-flex align-items-center">
        <div class="form-check mt-3">
          <input class="form-check-input" type="checkbox" id="is_active" name="is_active" <%= standard.is_active ? 'checked' : '' %> />
          <label class="form-check-label" for="is_active">启用状态</label>
        </div>
      </div>
      <div class="col-12">
        <label class="form-label">风险话术模板</label>
        <textarea name="risk_text" rows="4" class="form-control"><%= standard.risk_text || '' %></textarea>
      </div>
    </div>

    <div class="mt-4">
      <button type="submit" class="btn btn-primary">保存规则</button>
      <a href="/standards" class="btn btn-outline-secondary ms-2">取消</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
